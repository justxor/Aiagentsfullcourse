# Пример окружения. Скопируйте в .env и заполните.
# ВАЖНО: .env добавлен в .gitignore. Никогда не коммитьте настоящие ключи.
# ВАЖНО: эти переменные НЕ передаются в процесс агента внутри песочницы.
#        Инструменты, которым нужны секреты, выполняются на хосте.
#        Подробности: модуль 08, раздел 8.7.

# --- Провайдер модели -------------------------------------------------
# Любой совместимый с OpenAI API. Курс не зависит от конкретного вендора.
OPENAI_API_KEY=
# Необязательно: свой шлюз или локальный сервер (ollama, vllm, llama.cpp)
OPENAI_BASE_URL=

# --- Выбор моделей ----------------------------------------------------
# ВСЕГДА снапшот, а не алиас: алиас меняется без вашего участия,
# и вы узнаете об этом по падению эвалов. Модуль 13, раздел 13.2.
AGENT_MODEL_MAIN=gpt-4o-mini-2024-07-18
AGENT_MODEL_CHEAP=gpt-4o-mini-2024-07-18
AGENT_MODEL_JUDGE=gpt-4o-mini-2024-07-18
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Цены для учёта стоимости (USD за миллион токенов) ----------------
# Нужны, чтобы считать cost_usd в трейсе. Проверьте актуальные у провайдера.
PRICE_IN_PER_MTOK=0.15
PRICE_OUT_PER_MTOK=0.60
PRICE_CACHED_IN_PER_MTOK=0.02

# --- Бюджеты по умолчанию (модуль 01) --------------------------------
AGENT_MAX_STEPS=16
AGENT_MAX_SECONDS=300
AGENT_MAX_TOKENS=200000
AGENT_MAX_COST_USD=0.50
# Мягкий порог: доля бюджета, после которой агент получает
# предупреждение и должен подвести итог.
AGENT_SOFT_THRESHOLD=0.8

# --- Контекст (модуль 04) --------------------------------------------
CONTEXT_WINDOW=128000
# Доля окна, доступная под вход. Остальное - резерв на выход и страховку.
CONTEXT_MAX_INPUT_RATIO=0.70
# Порог запуска компакции (доля от полезного объёма).
COMPACTION_THRESHOLD=0.70
# Каждые N шагов - инкрементальная компакция.
COMPACTION_EVERY_STEPS=6

# --- Инструменты (модуль 02) -----------------------------------------
TOOL_OUTPUT_MAX_CHARS=4000
TOOL_TIMEOUT_DEFAULT=60
TOOL_TIMEOUT_TESTS=600
TOOL_RETRY_MAX=3

# --- RAG (модуль 05) -------------------------------------------------
RAG_TOP_K_SEARCH=30
RAG_TOP_K_CONTEXT=6
RAG_RERANK_THRESHOLD=0.35
RAG_MAX_PER_DOC=2
VECTOR_STORE=sqlite-vec
VECTOR_STORE_PATH=.data/index.db

# --- Песочница (модуль 08) -------------------------------------------
SANDBOX_IMAGE=agent-sandbox:latest
SANDBOX_CPUS=2
SANDBOX_MEMORY=4g
SANDBOX_PIDS_LIMIT=256
# none | proxy. В проде допустим только один из двух.
SANDBOX_NETWORK=none
# Белый список хостов для режима proxy, через запятую.
EGRESS_ALLOWLIST=pypi.org,files.pythonhosted.org,registry.npmjs.org

# --- Наблюдаемость (модуль 10) ---------------------------------------
AGENT_RUNS_DIR=runs
# Пусто = локальный режим: спаны пишутся в runs/*.jsonl
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agent
# Доля успешных прогонов, для которых сохраняются полные тексты.
TRACE_SAMPLE_SUCCESS=0.05

# --- Версии артефактов (модуль 13) -----------------------------------
PROMPTS_VERSION=v1
POLICY_VERSION=v1
MEMORY_SCHEMA=1
INDEX_SCHEMA=1

# --- Режимы работы ---------------------------------------------------
# fake   - детерминированная фиктивная модель, без сети и денег
# replay - проигрывание записанных ответов (тесты без сети)
# live   - реальный провайдер
AGENT_MODE=fake
# strict: при промахе кеша в режиме replay падать, а не идти в сеть
REPLAY_STRICT=1
